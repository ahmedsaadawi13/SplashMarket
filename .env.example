# FILE: /.env.example

# SplashMarket Environment Configuration
# Copy this file to .env and update with your actual values

# Application
APP_ENV=development
APP_URL=http://localhost

# Database
DB_HOST=localhost
DB_NAME=splashmarket
DB_USER=root
DB_PASS=

# Timezone
APP_TIMEZONE=UTC

# Session
SESSION_LIFETIME=86400

# File Uploads
MAX_UPLOAD_SIZE=5242880
